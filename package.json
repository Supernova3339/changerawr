{
  "name": "changerawr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:builder\" \"next dev -p 3001\"",
    "dev:builder": "node scripts/extension-builder/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:builder\"",
    "dev:next-only": "next dev -p 3001",
    "debug:maintenance": "concurrently \"npm run dev:builder\" \"npm run maintenance\"",
    "test:progress": "node scripts/test-progress.js",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "start:builder": "node scripts/extension-builder/server.js",
    "start:all": "concurrently \"npm start\" \"npm run start:builder\"",
    "lint": "next lint",
    "build:widget": "tsx scripts/widget/build.ts",
    "generate-swagger": "tsx scripts/api/generateSwagger.ts",
    "extensions:generate": "node scripts/generate-extension-imports.js && node scripts/generate-extension-safelist.js",
    "extensions:safelist": "node scripts/generate-extension-safelist.js",
    "extensions:restart": "node scripts/restart-with-maintenance.js",
    "start:prod": "NODE_ENV=production next start",
    "start:prod:win": "set NODE_ENV=production&& next start",
    "maintenance": "node scripts/maintenance/server.js",
    "start:with-maintenance": "bash docker-entrypoint.sh npm start",
    "prisma:studio": "npx prisma studio --schema=./prisma/schema --browser none",
    "prisma:generate": "npx prisma generate --schema=./prisma/schema",
    "prisma:migrate": "npx prisma migrate dev --schema=./prisma/schema",
    "prisma:migrate:deploy": "npx prisma migrate deploy --schema=./prisma/schema",
    "prisma:format": "npx prisma format --schema=./prisma/schema",
    "postinstall": "node scripts/sync-markdown.js"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
